# The build context is this directory (docker-compose.yml), so keep it to the
# files the API image actually needs.
.git
.gitignore
.vscode
.idea
*.log

venv/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]

# Local databases must never be baked into the image.
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

.env
.env.*
